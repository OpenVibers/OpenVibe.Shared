  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./account-switcher": "./account-switcher.js",
    "./analytics": "./analytics.js",
    "./app-icon": "./app-icon.js",
    "./auth-client": "./auth-client.js",
    "./brand": "./brand.js",
    "./builtin-themes": "./builtin-themes.js",
    "./chrome-ssr": "./chrome-ssr.js",
    "./files": "./files.js",
    "./footer": "./footer.js",
    "./history": "./history.js",
    "./icons": "./ov-icons.js",
    "./island": "./island.js",
    "./legal": "./legal.js",
    "./metrics": "./metrics.js",
    "./middleware": "./middleware.js",
    "./nav-icons": "./nav-icons.js",
    "./navbar": "./navbar.js",
    "./notification-ui": "./notification-ui.js",
    "./notifications": "./notifications.js",
    "./openvibe-sw": "./openvibe-sw.js",
    "./ov-icons": "./ov-icons.js",
    "./ov-mark": "./ov-mark.js",
    "./panels": "./panels.js",
    "./ready": "./ready.js",
    "./release": "./release.js",
    "./release-watch": "./release-watch.js",
    "./seo": "./seo.js",
    "./sso-client": "./sso-client.js",
    "./theme-loader": "./theme-loader.js",
    "./theme-sync": "./theme-sync.js",
    "./tooltip": "./tooltip.js",
    "./ui": "./ui.js",
    "./url-resolver": "./url-resolver.js",
    "./user-card": "./user-card.js"
