    "size": "node scripts/size-report.js",
    "build:icons": "python3 scripts/build-nav-icons.py",
    "build:themes": "node scripts/build-theme-loader.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenVibers/OpenVibe.Shared.git"
