    "./panels": "./panels.js",
    "./perf-budget": "./perf-budget.js",
    "./ready": "./ready.js",
    "./release": "./release.js",
    "./release-compat": "./release-compat.js",
    "./release-update": "./release-update.js",
    "./release-watch": "./release-watch.js",
    "./seo": "./seo.js",
